# Copy this file to .env. Keep real secrets out of Git and browser code.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com

# For Vercel, use an Upstash Redis REST database to persist cars, users, orders, and reviews.
TFA_STORE_URL=
TFA_STORE_TOKEN=

# Optional Google OAuth app. Add http://localhost:5173/api/oauth/google/callback as callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_OAUTH_ENABLED=false

# Optional GitHub OAuth app. Add http://localhost:5173/api/oauth/github/callback as callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_OAUTH_ENABLED=false
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5173/api/oauth/google/callback
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/oauth/github/callback

# Optional Cloudinary unsigned image upload preset (browser-side values are public).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional order notifications by Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMTP order email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_EMAIL=
